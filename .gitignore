# Virtual environments
venv/
.venv/
env/

# Byte-compiled files
__pycache__/
*.py[cod]
*.so

# Packaging and test artifacts
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Cached market data. Regenerated on demand, and not ours to redistribute.
data/cache/

# Interactive figures written by the charts self-test. Each one embeds its own
# data and a Plotly bundle reference, so they are large, regenerable and noisy in
# a diff. The PNG heatmaps in the same directory stay tracked: those are curated
# results referenced from the write-up, not test output.
output/*.html

# Notebooks
.ipynb_checkpoints/

# Editors and IDEs
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Environment variables
.env

# Internal planning brief. Kept on disk for local use; not part of the public repo.
GUIDELINE.md

# Local Streamlit skill shortcuts. They are relative symlinks into venv/, so they
# break for anyone who clones without that exact layout, and they are not part
# of the backtester.
.agents/
.claude/
